# Copy to .env (gitignored) and fill in. Run scripts/deploy_profile.sh afterwards to sync the
# Hermes keys (GEMINI_API_KEY, TELEGRAM_*) into the metaadsbot profile.

# gpt-image-2 (thumbnail image)
OPENAI_API_KEY=
# the poster planner and Hermes's own LLM
GEMINI_API_KEY=
# from @BotFather
TELEGRAM_BOT_TOKEN=
# your Telegram user id (comma-separated for several); the first one is also where finished ads are delivered
TELEGRAM_ALLOWED_USERS=
# optional: channel id (e.g. -100…) for Hermes alerts and the ad summary / failure notices; ads still go to the chat
# that asked (your first allowed user). Unset: everything goes to that chat. The bot must be an admin able to post.
# TELEGRAM_HOME_CHANNEL=

# Veo on Google Cloud (Vertex AI)
# your Google Cloud project id (billing on, Vertex AI API enabled)
GOOGLE_CLOUD_PROJECT=
# region, e.g. us-central1
GOOGLE_CLOUD_LOCATION=
# absolute path to the service-account JSON key file; put it in secrets/ (gitignored), e.g. /root/D7/MetaAdsAgent/secrets/vertex-sa.json
GOOGLE_APPLICATION_CREDENTIALS=
