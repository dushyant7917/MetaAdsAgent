# Copy to .env (gitignored) and fill in. Run scripts/deploy_profile.sh afterwards to sync the
# Hermes keys (GEMINI_API_KEY, TELEGRAM_*) into the metaadsbot profile.

# gpt-image-2 (thumbnail image)
OPENAI_API_KEY=
# the poster planner and Hermes's own LLM
GEMINI_API_KEY=
# from @BotFather
TELEGRAM_BOT_TOKEN=
# your Telegram user id (comma-separated for several); the first one is also where finished ads are delivered
TELEGRAM_ALLOWED_USERS=
# optional: channel id (e.g. -100…) for Hermes alerts and the ad summary / failure notices; ads still go to the chat
# that asked (your first allowed user). Unset: everything goes to that chat. The bot must be an admin able to post.
# TELEGRAM_HOME_CHANNEL=

# Veo on Google Cloud (Vertex AI)
# your Google Cloud project id (billing on, Vertex AI API enabled)
GOOGLE_CLOUD_PROJECT=
# region, e.g. us-central1
GOOGLE_CLOUD_LOCATION=
# absolute path to the service-account JSON key file; put it in secrets/ (gitignored), e.g. /root/D7/MetaAdsAgent/secrets/vertex-sa.json
GOOGLE_APPLICATION_CREDENTIALS=

# Meta ads upload (upload_ads). Ad account id WITHOUT the act_ prefix.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_APP_ID=
META_STORE_URL=
# optional: Instagram business account id, to also deliver on Instagram
META_IG_USER_ID=
# one campaign per language; only the languages you upload need one
META_CAMPAIGN_ID_HINDI=
META_CAMPAIGN_ID_TAMIL=
META_CAMPAIGN_ID_MARATHI=
META_CAMPAIGN_ID_GUJARATI=
META_CAMPAIGN_ID_BENGALI=
META_CAMPAIGN_ID_TELUGU=
META_CAMPAIGN_ID_KANNADA=

# optional: healthchecks.io ping URL for the 2-hourly auto-pause job (check: period 2 h, grace 20 min). It pings
# <url>/start, <url> on success and <url>/fail on error, and alerts you when no ping arrives, e.g. the VPS is down.
HEALTHCHECK_URL_AUTOPAUSE=

# optional: healthchecks.io ping URL for the daily budget-increase job (separate check: cron `0 5 * * *`, time zone
# Asia/Kolkata, grace 30 min). Pings <url>/start, <url> on success and <url>/fail on error, like HEALTHCHECK_URL_AUTOPAUSE.
HEALTHCHECK_URL_BUDGET_INCREASE=

# optional: healthchecks.io ping URL for the daily 12:00 IST ad plan (separate check: cron `0 12 * * *`, time zone
# Asia/Kolkata, grace 30 min). Pinged by propose_ad_plan when a plan was stored (or there was nothing to plan) and
# `/fail` when Meta could not be read, so it also alerts when the run never starts (e.g. the Hermes gateway is down).
HEALTHCHECK_URL_DAILY_PLAN=
